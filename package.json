  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoDaiGua-Ray/vue3-next-qrcode.git"
  },
  "bugs": {
    "url": "https://github.com/XiaoDaiGua-Ray/vue3-next-qrcode/issues"
  },
  "homepage": "https://github.com/XiaoDaiGua-Ray/vue3-next-qrcode#readme"
}
