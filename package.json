{
  "name": "vue3-next-qrcode",
  "private": false,
  "version": "4.1.0-beta.0",
  "type": "module",
  "license": "MIT",
  "author": "Ray",
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "es/index.d.ts",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./client": {
      "types": "./es/client.d.ts",
      "import": "./es/client.mjs",
      "require": "./lib/client.cjs"
    },
    "./style.css": "./es/style.css",
    "./es/style.css": "./es/style.css",
    "./lib/style.css": "./lib/style.css"
  },
  "files": [
    "lib",
    "es",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "keywords": [
    "vue3",
    "qrcode",
    "vue3-next-qrcode",
    "ssr"
  ],
  "scripts": {
    "dev": "vite --config vite.build.config.ts",
    "build": "pnpm run build:lib && pnpm run build:umd",
    "build:lib": "vite build --config vite.build.config.ts",
    "build:umd": "vite build --config vite.bundle.config.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint components src --ext .ts,.tsx,.vue",
    "lint:fix": "eslint components src --ext .ts,.tsx,.vue --fix",
    "test:smoke": "node scripts/smoke.mjs",
    "test": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run build && pnpm run test:smoke",
    "format": "prettier --write \"components/**/*.{ts,tsx,vue,scss}\" \"src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"components/**/*.{ts,tsx,vue,scss}\" \"src/**/*.{ts,vue}\""
  },
  "dependencies": {
    "js-binary-schema-parser": "^2.0.3"
  },
  "peerDependencies": {
    "vue": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.2"
  },
